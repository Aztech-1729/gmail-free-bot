# ============================================================
#  GMAILS FREE BOT — configuration
#  Copy this file to `.env` and fill in your credentials.
# ============================================================

# 1) Bot token from @BotFather (https://t.me/BotFather → /newbot)
BOT_TOKEN=PASTE_BOT_TOKEN_HERE

# 2) Polling interval in seconds for incoming mail (default 10)
POLL_INTERVAL=5

# 3) Storage — MongoDB Atlas (falls back to local SQLite if empty/unreachable)
MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/gmailotp?retryWrites=true&w=majority
MONGO_DB=gmailotp
